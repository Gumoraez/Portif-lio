-- Medidas DAX — Dashboard de Vendas de Varejo
-- Modelo estrela: fato_vendas -> dim_loja (id_loja), dim_produto (id_produto), dCalendario (data)

Faturamento = SUM ( fato_vendas[valor] )

Qtd Vendas = COUNTROWS ( fato_vendas )

Ticket Médio = DIVIDE ( [Faturamento], [Qtd Vendas] )

Faturamento Semestre Anterior =
CALCULATE ( [Faturamento], DATEADD ( dCalendario[Data], -6, MONTH ) )

Variação vs Semestre Anterior % =
DIVIDE ( [Faturamento] - [Faturamento Semestre Anterior], [Faturamento Semestre Anterior] )

% Mix Acessórios =
DIVIDE (
    CALCULATE ( [Qtd Vendas], dim_produto[categoria] = "Acessórios" ),
    [Qtd Vendas]
)

Ranking Loja = RANKX ( ALL ( dim_loja[loja] ), [Faturamento] )

-- Tabela calendário (Modelagem > Nova tabela)
dCalendario =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2025, 1, 1 ), DATE ( 2025, 12, 31 ) ),
    "Ano", YEAR ( [Date] ),
    "Mês", FORMAT ( [Date], "mmm" ),
    "Nº Mês", MONTH ( [Date] ),
    "Semestre", IF ( MONTH ( [Date] ) <= 6, "1º Sem", "2º Sem" )
)
